<Window x:Class="RigUninstaller.Views.LeftoversWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Leftovers"
        Width="900" Height="620" MinWidth="720" MinHeight="460"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Style="{StaticResource AppWindow}">
    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Heading}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />

        <!-- What this is, and the promise that nothing happens without a click -->
        <TextBlock Grid.Row="1" Margin="0,6,0,14" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}"
                   Text="These look like they belong to the program you just removed. Nothing is deleted until you tick items and click Remove. Tick only what you recognise." />

        <Border Grid.Row="2" CornerRadius="8" BorderThickness="1"
                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Quick-tick toolbar -->
                <Grid Grid.Row="0" Margin="14,10,14,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Tick all High" Command="{Binding TickHighCommand}"
                                Style="{StaticResource AppButton}" Padding="12,6" Margin="0,0,8,0" />
                        <Button Content="Tick all shown" Command="{Binding TickAllCommand}"
                                Style="{StaticResource AppButton}" Padding="12,6" Margin="0,0,8,0" />
                        <Button Content="Untick all" Command="{Binding UntickAllCommand}"
                                Style="{StaticResource AppButton}" Padding="12,6" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource TextMutedBrush}"
                                   Visibility="{Binding HiddenLowCount, Converter={StaticResource CountToVis}}">
                            <Run Text="{Binding HiddenLowCount, Mode=OneWay}" /><Run Text=" low-confidence hidden" />
                        </TextBlock>
                        <CheckBox Content="Show low-confidence" IsChecked="{Binding ShowLow}" />
                    </StackPanel>
                </Grid>
                <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource DividerBrush}" />

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding VisibleRows}" KeyboardNavigation.TabNavigation="Continue">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerBrush}" Padding="14,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="86" />
                                            <ColumnDefinition Width="104" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center"
                                                  AutomationProperties.Name="{Binding Path}" />

                                        <!-- Words, not only colour, say how sure the match is -->
                                        <Border Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                Margin="12,0,0,0" Padding="9,2" CornerRadius="10" BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ConfidenceText}" Value="High">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ConfidenceText}" Value="Medium">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource WarnBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding ConfidenceText}" FontSize="12" FontWeight="SemiBold" />
                                        </Border>

                                        <TextBlock Grid.Column="2" Text="{Binding TypeText}" VerticalAlignment="Center"
                                                   Margin="12,0,0,0" Foreground="{DynamicResource TextMutedBrush}" />

                                        <StackPanel Grid.Column="3" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding Path}" FontFamily="Consolas" FontSize="12"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                            <TextBlock Text="{Binding Reason}" FontSize="12" Margin="0,2,0,0"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Reason}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Footer: what will happen, restore point, actions -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                           Text="Files and folders go to the Recycle Bin, so you can restore them. Registry keys are saved to a .reg backup file first (Data\Backups)." />
                <CheckBox Content="Create a System Restore point first (recommended)" Margin="0,10,0,0"
                          IsChecked="{Binding CreateRestorePoint}"
                          Visibility="{Binding ShowRestorePointOption, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                <Button Content="Keep everything" Command="{Binding CloseCommand}" IsCancel="True" IsDefault="True"
                        Style="{StaticResource AppButton}" MinWidth="120" />
                <Button Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" Tag="primary"
                        Style="{StaticResource AppButton}" Margin="10,0,0,0" MinWidth="160" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
