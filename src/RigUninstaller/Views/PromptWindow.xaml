<Window x:Class="RigUninstaller.Views.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="560" SizeToContent="Height" MaxHeight="760" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Style="{StaticResource AppWindow}">
    <StackPanel Margin="28,26,28,22">
        <TextBlock Text="{Binding Heading}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsWarning}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <TextBlock Text="{Binding Body}" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="20"
                   Foreground="{DynamicResource TextMutedBrush}" />

        <!-- Optional list, e.g. the running processes or the things that will be removed -->
        <Border Margin="0,16,0,0" Padding="12,8" CornerRadius="8" MaxHeight="190"
                Background="{DynamicResource SurfaceAltBrush}"
                Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12" Margin="0,3" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <ItemsControl ItemsSource="{Binding Options}" Margin="0,16,0,0"
                      Visibility="{Binding HasOptions, Converter={StaticResource BoolToVis}}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding Text}" IsChecked="{Binding IsChecked}" Margin="0,5" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl ItemsSource="{Binding Buttons}" Margin="0,24,0,0" HorizontalAlignment="Right">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Content="{Binding Label}" Tag="{Binding StyleTag}"
                            IsDefault="{Binding IsDefault}" IsCancel="{Binding IsCancel}"
                            Command="{Binding DataContext.ChooseCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding Key}"
                            Style="{StaticResource AppButton}" MinWidth="96" Margin="10,0,0,0" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</Window>
