<Window x:Class="RigUninstaller.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:RigUninstaller.Views"
        xmlns:helpers="clr-namespace:RigUninstaller.Helpers"
        xmlns:svc="clr-namespace:RigUninstaller.Services"
        Title="RigUninstaller"
        Width="1280" Height="760" MinWidth="900" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource AppWindow}">
    <Window.InputBindings>
        <!-- Ctrl+F jumps to the search box (handled in code-behind: it is pure focus handling). -->
        <KeyBinding Key="F" Modifiers="Control" Command="Find" />
        <KeyBinding Key="F5" Command="{Binding ScanCommand}" />
    </Window.InputBindings>

    <WindowChrome.WindowChrome>
        <!-- The title bar below replaces the Windows one; resize, snap and double-click-to-maximise still work. -->
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="WindowRoot">
      <Grid.RowDefinitions>
        <RowDefinition Height="40" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Title bar: icon, window title (the Title attribute above), caption buttons -->
      <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
        <Grid>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
            <Image Source="{Binding Icon, RelativeSource={RelativeSource AncestorType=Window}}"
                   Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                       FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                      WindowChrome.IsHitTestVisibleInChrome="True">
            <!-- App-wide actions live in the title bar, so every tab keeps its full height -->
            <Button Content="Rescan" Command="{Binding ScanCommand}" Style="{StaticResource AppButton}"
                    Padding="12,3" Height="28" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"
                    ToolTip="Read the installed programs again (F5)" />
            <Button Content="{Binding ThemeButtonText}" Command="{Binding ToggleThemeCommand}" Style="{StaticResource AppButton}"
                    Padding="12,3" Height="28" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
            <Button Content="View log" Command="{Binding ViewLogCommand}" Style="{StaticResource AppButton}"
                    Padding="12,3" Height="28" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" />
            <Button x:Name="MinimizeButton" Content="&#xE921;" Style="{StaticResource CaptionButton}"
                    Click="OnMinimizeClick" AutomationProperties.Name="Minimize" />
            <Button x:Name="MaximizeButton" Content="&#xE922;" Style="{StaticResource CaptionButton}"
                    Click="OnMaximizeClick" AutomationProperties.Name="Maximize" />
            <Button Content="&#xE8BB;" Tag="close" Style="{StaticResource CaptionButton}"
                    Click="OnCloseClick" AutomationProperties.Name="Close" />
          </StackPanel>
        </Grid>
      </Border>

    <Grid Grid.Row="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: search and the main uninstall action. Only the Programs tab needs it. -->
            <Grid Grid.Row="0" Margin="24,14,24,0"
                  Visibility="{Binding IsProgramsTab, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MaxWidth="480" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchBox" Grid.Column="1"
                         Style="{StaticResource SearchBox}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Tag="{Binding ClearSearchCommand}"
                         Visibility="{Binding IsProgramsTab, Converter={StaticResource BoolToVis}}"
                         ToolTip="Search by name, publisher or version (Ctrl+F). Type a drive like F: to see only the programs on that drive."
                         AutomationProperties.Name="Search programs, or a drive like F:">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}" />
                    </TextBox.InputBindings>
                </TextBox>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{Binding UninstallButtonText}" Command="{Binding UninstallCommand}" Tag="primary" MaxWidth="320"
                            Style="{StaticResource AppButton}"
                            ToolTip="Uninstall the selected program (Delete)" />
                </StackPanel>
            </Grid>

            <TabControl Grid.Row="1" Margin="24,12,24,14" SelectedIndex="{Binding SelectedTabIndex}">

                <!-- ================= Programs ================= -->
                <TabItem Header="Programs">
                    <Grid helpers:Motion.RiseIn="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Selection summary on the left, then batch actions, then the few helper tools -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center" Margin="2,0,16,0">
                                <TextBlock Text="{Binding SelectionSummary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding SelectionSummary}" />
                                <TextBlock Text="{Binding SelectionDetail}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectionDetail}" Margin="0,1,0,0" />
                                <!-- Warning for the selected program: text and a symbol, not colour alone -->
                                <!-- A grid, not a horizontal panel: the text gets a real width, so it can end in an ellipsis -->
                                <Grid Margin="0,3,0,0" Visibility="{Binding HasSelectionRisk, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                               VerticalAlignment="Center" Margin="0,0,6,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectionRiskIsDanger}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectionRisk}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding SelectionRisk}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectionRiskIsDanger}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0"
                                        Visibility="{Binding HasChecked, Converter={StaticResource BoolToVis}}">
                                <Button Content="{Binding BatchButtonText}" Command="{Binding BatchUninstallCommand}" Tag="primary"
                                        Style="{StaticResource AppButton}" Padding="14,6" Margin="0,0,8,0"
                                        ToolTip="Uninstall every program you ticked, one after another" />
                                <Button Content="Clear ticks" Command="{Binding ClearChecksCommand}"
                                        Style="{StaticResource AppButton}" Padding="12,6" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Ready-made views of the list (the menu itself is built in code-behind from QuickFilters) -->
                                <Button x:Name="QuickFilterButton" Padding="12,6" Margin="0,0,8,0" Click="OnQuickFilterClick"
                                        AutomationProperties.Name="Quick filter"
                                        ToolTip="{Binding QuickFilterHint}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource AppButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsQuickFilterActive}" Value="True">
                                                    <Setter Property="Tag" Value="primary" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <!-- A funnel -->
                                        <Path Data="M1,2 L15,2 L9.5,8.5 L9.5,14 L6.5,12.5 L6.5,8.5 Z" Width="16" Height="16"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.4" StrokeLineJoin="Round" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding QuickFilterButtonText}" Margin="8,0,0,0" MaxWidth="260" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Button>

                                <!-- The no-aiming way to the same answer: pick from the windows that are open right now -->
                                <Button x:Name="OpenWindowsButton" Style="{StaticResource AppButton}" Padding="12,6" Margin="0,0,8,0"
                                        Click="OnOpenWindowsClick"
                                        AutomationProperties.Name="Pick from open windows"
                                        ToolTip="List the windows open right now and pick one. Its program is selected in the list.">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Open windows" />
                                        <Path Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5" Width="8" Height="5"
                                              Margin="8,1,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Button.ContextMenu>
                                        <ContextMenu />
                                    </Button.ContextMenu>
                                </Button>

                                <!-- Less common helpers live in one menu instead of five buttons -->
                                <Button x:Name="ToolsButton" Style="{StaticResource AppButton}" Padding="12,6" Click="OnToolsClick"
                                        AutomationProperties.Name="More tools" ToolTip="Install tracker, winget, export, bloatware list">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="More tools" />
                                        <Path Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5" Width="8" Height="5"
                                              Margin="8,1,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{Binding TrackButtonText}" Command="{Binding TrackInstallCommand}"
                                                      ToolTip="Take a snapshot, install something, then finish: the changes are saved so its leftovers can be removed exactly" />
                                            <MenuItem Header="Cancel tracking" Command="{Binding CancelTrackingCommand}"
                                                      Visibility="{Binding IsTracking, Converter={StaticResource BoolToVis}}" />
                                            <Separator />
                                            <MenuItem Header="Check winget for updates" Command="{Binding WingetCheckCommand}" />
                                            <MenuItem Header="Tick all bloatware" Command="{Binding TickBloatCommand}" />
                                            <MenuItem Header="Edit bloatware list" Command="{Binding EditBloatwareCommand}" />
                                            <Separator />
                                            <MenuItem Header="Export list to CSV" Command="{Binding ExportCsvCommand}" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                            <Grid>
                                <DataGrid x:Name="ProgramGrid"
                                          Style="{StaticResource ProgramGrid}"
                                          ItemsSource="{Binding Rows}"
                                          SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                                          AutomationProperties.Name="Installed programs"
                                          Sorting="OnSorting">
                                    <DataGrid.InputBindings>
                                        <KeyBinding Key="Delete" Command="{Binding UninstallCommand}" />
                                    </DataGrid.InputBindings>
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow" BasedOn="{StaticResource GridRow}">
                                            <Style.Triggers>
                                                <!-- Bloatware rows get a warm tint (and a "Bloat" label), so it is not colour alone. -->
                                                <DataTrigger Binding="{Binding IsBloat}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource BloatRowBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>

                                    <DataGrid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Uninstall" Command="{Binding UninstallCommand}" />
                                            <MenuItem Header="Force remove..." Command="{Binding ForceRemoveCommand}" Foreground="{DynamicResource WarnBrush}"
                                                      ToolTip="For broken entries: removes the registry entry and the install folder without running the uninstaller" />
                                            <MenuItem Header="Scan with Microsoft Defender" Command="{Binding DefenderScanCommand}" />
                                            <Separator />
                                            <MenuItem Header="Open install folder" Command="{Binding OpenFolderCommand}" />
                                            <MenuItem Header="Open registry key" Command="{Binding OpenRegistryCommand}" />
                                            <MenuItem Header="Search online" Command="{Binding SearchOnlineCommand}" />
                                            <Separator />
                                            <MenuItem Header="Keep (protect from removal)" Command="{Binding ToggleKeepCommand}"
                                                      IsChecked="{Binding SelectedRow.IsKept, Mode=OneWay}" />
                                            <Separator />
                                            <MenuItem Header="Uninstall with winget" Command="{Binding WingetUninstallCommand}" />
                                            <MenuItem Header="Update with winget" Command="{Binding WingetUpdateCommand}" />
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>

                                    <DataGrid.Columns>
                                        <!-- Tick for a batch uninstall -->
                                        <DataGridTemplateColumn Width="44" CanUserSort="False" CanUserResize="False" CanUserReorder="False" IsReadOnly="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}"
                                                              IsEnabled="{Binding CanTick}" HorizontalAlignment="Center"
                                                              AutomationProperties.Name="Tick for batch uninstall"
                                                              ToolTip="Tick to include in a batch uninstall" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- Icon: real icon when found, otherwise a letter tile -->
                                        <DataGridTemplateColumn Width="52" CanUserSort="False" CanUserResize="False"
                                                                CanUserReorder="False" IsReadOnly="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Border CornerRadius="7" Background="{Binding TileColor}">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding Initial}" Foreground="#FFFFFF"
                                                                       FontWeight="SemiBold" FontSize="14"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <Image Source="{Binding Icon}" Width="24" Height="24"
                                                               RenderOptions.BitmapScalingMode="HighQuality"
                                                               Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- Name with its tags -->
                                        <DataGridTemplateColumn Header="Name" Width="1.7*" MinWidth="260" SortMemberPath="Name" SortDirection="Ascending" IsReadOnly="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Name}" FontWeight="Medium" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                            <!-- Removing this can lag or crash the PC: drivers, runtimes, security software -->
                                                            <Border Visibility="{Binding HasRisk, Converter={StaticResource BoolToVis}}"
                                                                    ToolTip="{Binding RiskReason}">
                                                                <Border.Style>
                                                                    <Style TargetType="Border" BasedOn="{StaticResource TagPill}">
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource WarnBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsDanger}" Value="True">
                                                                                <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                                                               VerticalAlignment="Center" Margin="0,0,4,0">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsDanger}" Value="True">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                    <TextBlock Text="{Binding RiskLabel}" FontSize="11" FontWeight="SemiBold" />
                                                                </StackPanel>
                                                            </Border>
                                                            <Border Style="{StaticResource TagPill}" BorderBrush="{DynamicResource AccentBrush}"
                                                                    Visibility="{Binding IsKept, Converter={StaticResource BoolToVis}}"
                                                                    ToolTip="Marked Keep: it cannot be uninstalled or force removed until you untick Keep">
                                                                <TextBlock Text="Keep" FontSize="11" FontWeight="SemiBold" />
                                                            </Border>
                                                            <Border Style="{StaticResource TagPill}" BorderBrush="{DynamicResource WarnBrush}"
                                                                    Visibility="{Binding IsBloat, Converter={StaticResource BoolToVis}}"
                                                                    ToolTip="On your bloatware list">
                                                                <TextBlock Text="Bloat" FontSize="11" FontWeight="SemiBold" />
                                                            </Border>
                                                            <Border Style="{StaticResource TagPill}" BorderBrush="{DynamicResource WarnBrush}"
                                                                    Visibility="{Binding IsOrphan, Converter={StaticResource BoolToVis}}"
                                                                    ToolTip="{Binding OrphanReason}">
                                                                <TextBlock Text="Broken entry" FontSize="11" FontWeight="SemiBold" />
                                                            </Border>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- Short columns have a fixed width wide enough for their text; the text columns share the rest. -->
                                        <DataGridTextColumn Header="Publisher" Width="*" MinWidth="130" SortMemberPath="Publisher"
                                                            Binding="{Binding Publisher, Mode=OneWay}"
                                                            ElementStyle="{StaticResource CellTextMuted}" />
                                        <!-- The drive the program is installed on. Type "F:" in the search box to see only that drive. -->
                                        <DataGridTextColumn Header="Drive" Width="76" MinWidth="64" SortMemberPath="Drive"
                                                            Binding="{Binding DriveText, Mode=OneWay}"
                                                            ElementStyle="{StaticResource CellTextMuted}" />
                                        <DataGridTextColumn Header="Version" Width="124" MinWidth="90" SortMemberPath="Version"
                                                            Binding="{Binding Version, Mode=OneWay}"
                                                            ElementStyle="{StaticResource CellTextMuted}" />
                                        <DataGridTextColumn Header="Size" Width="104" MinWidth="80" SortMemberPath="Size"
                                                            HeaderStyle="{StaticResource GridColumnHeaderRight}"
                                                            Binding="{Binding SizeText, Mode=OneWay}"
                                                            ElementStyle="{StaticResource CellTextNumber}" />
                                        <DataGridTextColumn Header="Installed" Width="122" MinWidth="100" SortMemberPath="InstallDate"
                                                            Binding="{Binding InstallDateText, Mode=OneWay}"
                                                            ElementStyle="{StaticResource CellTextMuted}" />
                                        <DataGridTextColumn Header="Last used" Width="128" MinWidth="104" SortMemberPath="LastUsed"
                                                            Binding="{Binding LastUsedText, Mode=OneWay}"
                                                            ElementStyle="{StaticResource CellTextMuted}" />

                                        <!-- Digital signature of the uninstaller; unsigned ones are highlighted -->
                                        <DataGridTemplateColumn Header="Signed by" Width="150" MinWidth="110" CanUserSort="False" IsReadOnly="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding SignedByText}" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding SignedByText}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsUnsigned}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTextColumn x:Name="WingetColumn" Header="winget" Width="110" MinWidth="70" CanUserSort="False"
                                                            Binding="{Binding WingetText, Mode=OneWay}"
                                                            ElementStyle="{StaticResource CellTextMuted}" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- Search matched nothing -->
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding NoResultsText}" FontSize="15" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding NoResultsAdvice}"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"
                                               HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="520" TextAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                                        <Button Content="Clear search" Command="{Binding ClearSearchCommand}"
                                                Style="{StaticResource AppButton}" Margin="0,0,8,0" />
                                        <Button Content="Show all programs" Command="{Binding SetQuickFilterCommand}"
                                                CommandParameter="{x:Static svc:QuickFilter.All}"
                                                Style="{StaticResource AppButton}"
                                                Visibility="{Binding IsQuickFilterActive, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- First scan still running: grey placeholder rows keep the page's shape -->
                                <Grid Visibility="{Binding ShowScanningHint, Converter={StaticResource BoolToVis}}"
                                      Background="{DynamicResource SurfaceBrush}" Margin="0,38,0,0" helpers:Motion.FadeIn="True">
                                    <views:SkeletonRows RowCount="12" />
                                    <TextBlock Text="Scanning installed programs..." FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ================= Disk usage ================= -->
                <TabItem Header="Disk usage">
                    <Grid DataContext="{Binding DiskUsage}" helpers:Motion.RiseIn="True">
                        <TabControl>
                            <!-- Every drive, and the folders that fill it -->
                            <TabItem Header="Drives and folders">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <ItemsControl Grid.Row="0" ItemsSource="{Binding Drives}" Margin="0,0,0,12">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="228" Margin="0,0,10,10" Padding="16,12" CornerRadius="10" BorderThickness="1"
                                                        Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}">
                                                    <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Format}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" />
                                                        </Grid>
                                                        <ProgressBar Margin="0,10,0,8" Minimum="0" Maximum="1" Value="{Binding UsedFraction, Mode=OneWay}">
                                                            <ProgressBar.Style>
                                                                <Style TargetType="ProgressBar" BasedOn="{StaticResource UsageBar}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsLow}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ProgressBar.Style>
                                                        </ProgressBar>
                                                        <TextBlock Text="{Binding FreeText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding FreeText}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsLow}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding UsedText}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,10" />
                                                        <Button Content="See folders" Style="{StaticResource AppButton}" Padding="12,6"
                                                                Command="{Binding DataContext.ScanDriveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="8">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <!-- Nothing picked yet: say what to do instead of showing buttons that cannot act -->
                                            <TextBlock Grid.RowSpan="2" Text="Pick a drive above and press See folders to find what is using its space."
                                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="14"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasCurrentPath}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- Where you are, with the way back up -->
                                            <Grid Margin="16,12" Visibility="{Binding HasCurrentPath, Converter={StaticResource BoolToVis}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Button Content="Up" Command="{Binding UpCommand}" Style="{StaticResource AppButton}" Padding="12,5" Margin="0,0,12,0" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding CurrentPath}" FontFamily="Consolas" FontSize="13" TextTrimming="CharacterEllipsis"
                                                               Visibility="{Binding HasCurrentPath, Converter={StaticResource BoolToVis}}" />
                                                    <TextBlock Text="{Binding FolderStatus}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FolderStatus}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                    <Button Content="Stop" Command="{Binding StopScanCommand}" Style="{StaticResource AppButton}" Padding="12,5" Margin="0,0,8,0" />
                                                    <Button Content="Measure again" Command="{Binding RescanFolderCommand}" Style="{StaticResource AppButton}" Padding="12,5" Margin="0,0,8,0" />
                                                    <Button Content="Open in Explorer" Command="{Binding ExploreCommand}" Style="{StaticResource AppButton}" Padding="12,5" />
                                                </StackPanel>
                                            </Grid>
                                            <Border Height="1" VerticalAlignment="Bottom" Background="{DynamicResource DividerBrush}"
                                                    Visibility="{Binding HasCurrentPath, Converter={StaticResource BoolToVis}}" />

                                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding FolderRows}" Margin="8,6">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}" Style="{StaticResource RowButton}"
                                                                    AutomationProperties.Name="{Binding Name}">
                                                                <Grid Margin="10,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="300" />
                                                                        <ColumnDefinition Width="70" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="100" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding KindText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" />
                                                                    <ProgressBar Grid.Column="2" Style="{StaticResource UsageBar}" Minimum="0" Maximum="{Binding Maximum}" Value="{Binding Bytes, Mode=OneWay}" />
                                                                    <TextBlock Grid.Column="3" Text="{Binding SizeText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                               Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource TextMutedBrush}" />
                                                                </Grid>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </TabItem>

                            <!-- The programs that use the most space -->
                            <TabItem Header="Biggest programs">
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="24,18">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Heading}" FontSize="16" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding TotalText}" FontWeight="SemiBold" Margin="0,3,0,0" />
                                                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}"
                                                    Style="{StaticResource AppButton}" VerticalAlignment="Top" />
                                        </Grid>
                                        <Grid Grid.Row="1">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <!-- Pick All drives or one drive; each button shows what that drive's programs add up to -->
                                            <ItemsControl ItemsSource="{Binding DriveFilters}" Margin="0,0,0,12">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource AppButton}" Tag="{Binding ButtonTag}" Padding="14,8" Margin="0,0,8,8"
                                                                Command="{Binding DataContext.SelectDriveFilterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}" AutomationProperties.Name="{Binding Label}">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding TotalText}" Opacity="0.85" FontSize="12" Typography.NumeralAlignment="Tabular" />
                                                                <TextBlock Text="{Binding CountText}" Opacity="0.7" FontSize="11" />
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <views:SkeletonRows Grid.Row="1" RowCount="8" ShowTick="False"
                                                                Visibility="{Binding ShowSkeleton, Converter={StaticResource BoolToVis}}" />
                                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                                          helpers:Motion.FadeIn="True">
                                                <ItemsControl ItemsSource="{Binding Rows}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,5">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="260" />
                                                                    <ColumnDefinition Width="48" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="90" />
                                                                    <ColumnDefinition Width="52" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                           ToolTip="{Binding Name}" Margin="0,0,16,0" />
                                                                <TextBlock Grid.Column="1" Text="{Binding Drive}" VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                                                <ProgressBar Grid.Column="2" Style="{StaticResource UsageBar}" Minimum="0"
                                                                             Maximum="{Binding Maximum}" Value="{Binding Bytes, Mode=OneWay}" />
                                                                <TextBlock Grid.Column="3" Text="{Binding SizeText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                           Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource TextMutedBrush}" />
                                                                <TextBlock Grid.Column="4" Text="{Binding ShareText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                           Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource TextMutedBrush}"
                                                                           ToolTip="Share of the total shown above" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </TabItem>

                <!-- ================= Store apps ================= -->
                <TabItem Header="Store apps">
                    <Grid DataContext="{Binding Store}" helpers:Motion.RiseIn="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MaxWidth="420" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource SearchBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="{Binding ClearSearchCommand}" AutomationProperties.Name="Search Store apps" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox Content="Show Windows' own packages" IsChecked="{Binding ShowSystem}" Margin="0,0,16,0" />
                                <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource AppButton}" />
                            </StackPanel>
                        </Grid>
                        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <DataGrid Style="{StaticResource ProgramGrid}" ItemsSource="{Binding Items}"
                                          AutomationProperties.Name="Store apps">
                                    <DataGrid.Columns>
                                        <!-- App tile logo, or the grey "no icon" picture -->
                                        <DataGridTemplateColumn Width="52" CanUserSort="False" CanUserResize="False"
                                                                CanUserReorder="False" IsReadOnly="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Width="28" Height="28" CornerRadius="7" HorizontalAlignment="Center"
                                                            VerticalAlignment="Center" Background="{DynamicResource SurfaceAltBrush}">
                                                        <Image Source="{Binding Icon}" Width="22" Height="22"
                                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Name" Width="*" MinWidth="220" Binding="{Binding Name, Mode=OneWay}" ElementStyle="{StaticResource CellTextName}" />
                                        <DataGridTextColumn Header="Publisher" Width="220" Binding="{Binding Publisher, Mode=OneWay}" ElementStyle="{StaticResource CellTextMuted}" />
                                        <DataGridTextColumn Header="Version" Width="130" Binding="{Binding Version, Mode=OneWay}" ElementStyle="{StaticResource CellTextMuted}" />
                                        <DataGridTextColumn Header="Note" Width="220" Binding="{Binding StateText, Mode=OneWay}" ElementStyle="{StaticResource CellTextMuted}" />
                                        <DataGridTemplateColumn Width="110" CanUserSort="False" IsReadOnly="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Remove" Style="{StaticResource AppButton}" Padding="12,4"
                                                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <!-- Placeholder rows while the packages are being read -->
                                <Border Background="{DynamicResource SurfaceBrush}" Margin="0,38,0,0" VerticalAlignment="Top" Height="320"
                                        Visibility="{Binding ShowSkeleton, Converter={StaticResource BoolToVis}}" helpers:Motion.FadeIn="True">
                                    <views:SkeletonRows RowCount="7" ShowTick="False" />
                                </Border>
                                <TextBlock Grid.Row="1" Text="{Binding StatusText}" Margin="16,8" Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="12" TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ================= Startup ================= -->
                <TabItem Header="Startup">
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" DataContext="{Binding Startup}" helpers:Motion.RiseIn="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DataGrid Style="{StaticResource ProgramGrid}" ItemsSource="{Binding Items}" AutomationProperties.Name="Startup items">
                                <DataGrid.Columns>
                                    <!-- The program's icon, or the grey "no icon" picture -->
                                    <DataGridTemplateColumn Width="52" CanUserSort="False" CanUserResize="False"
                                                            CanUserReorder="False" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Width="28" Height="28" CornerRadius="7" HorizontalAlignment="Center"
                                                        VerticalAlignment="Center" Background="{DynamicResource SurfaceAltBrush}">
                                                    <Image Source="{Binding Icon}" Width="22" Height="22"
                                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Name" Width="200" Binding="{Binding Name, Mode=OneWay}" ElementStyle="{StaticResource CellTextName}" />
                                    <DataGridTextColumn Header="Where" Width="210" Binding="{Binding Location, Mode=OneWay}" ElementStyle="{StaticResource CellTextMuted}" />
                                    <DataGridTextColumn Header="Command" Width="*" MinWidth="200" Binding="{Binding Command, Mode=OneWay}" ElementStyle="{StaticResource CellTextMuted}" />
                                    <!-- On: green dot and word. Off: empty ring and muted word. The word is always there, not colour alone. -->
                                    <DataGridTemplateColumn Header="State" Width="84" CanUserSort="False" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="9" Height="9" StrokeThickness="1.5" Margin="0,0,8,0" VerticalAlignment="Center">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="Transparent" />
                                                                <Setter Property="Stroke" Value="{DynamicResource TextMutedBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                                        <Setter Property="Fill" Value="{DynamicResource OkBrush}" />
                                                                        <Setter Property="Stroke" Value="{DynamicResource OkBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding StateText}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="120" CanUserSort="False" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding ActionText}" Style="{StaticResource AppButton}" Padding="12,4"
                                                        Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <!-- Placeholder rows while the list is being read -->
                            <Border Background="{DynamicResource SurfaceBrush}" Margin="0,38,0,0" VerticalAlignment="Top" Height="320"
                                    Visibility="{Binding ShowSkeleton, Converter={StaticResource BoolToVis}}" helpers:Motion.FadeIn="True">
                                <views:SkeletonRows RowCount="7" ShowTick="False" />
                            </Border>
                            <Grid Grid.Row="1" Margin="16,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                                    <Button Content="Add app..." Command="{Binding AddCommand}" Tag="primary" Style="{StaticResource AppButton}"
                                            Padding="14,5" Margin="0,0,8,0"
                                            ToolTip="Pick a program that should start with Windows" />
                                    <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource AppButton}" Padding="12,5" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </TabItem>

                <!-- ================= Cleanup ================= -->
                <TabItem Header="Cleanup">
                    <TabControl helpers:Motion.RiseIn="True">

                        <!-- Temp files and caches: tick what to clean, one confirmation, nothing outside the list can be touched -->
                        <TabItem Header="Temp and cache">
                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="8" DataContext="{Binding CacheCleanup}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Margin="20,16,20,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Temporary files and caches" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Measure again" Command="{Binding ScanCommand}"
                                                Style="{StaticResource AppButton}" VerticalAlignment="Top" />
                                    </Grid>

                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding Rows}" Margin="8,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="12,12">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding CanTick}" VerticalAlignment="Top"
                                                                      Margin="0,2,16,0" AutomationProperties.Name="{Binding Name}" />
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                                                                           TextWrapping="Wrap" Margin="0,2,0,0" />
                                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                                                            Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}">
                                                                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                                                               Foreground="{DynamicResource WarnBrush}" VerticalAlignment="Top" Margin="0,2,6,0" />
                                                                    <TextBlock Text="{Binding Note}" Foreground="{DynamicResource WarnBrush}" FontSize="12"
                                                                               TextWrapping="Wrap" MaxWidth="760" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" Margin="16,0,0,0" MinWidth="110">
                                                                <TextBlock Text="{Binding SizeText}" FontWeight="SemiBold" HorizontalAlignment="Right"
                                                                           Typography.NumeralAlignment="Tabular" />
                                                                <TextBlock Text="{Binding FilesText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                                                                           HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <Border Grid.Row="2" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="20,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SelectedText}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding ResultText}" Foreground="{DynamicResource OkBrush}" FontWeight="SemiBold" FontSize="12"
                                                           TextWrapping="Wrap" Margin="0,2,0,0"
                                                           Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Text="Deleted for good, not sent to the Recycle Bin. Files in use are skipped." FontSize="12"
                                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="Stop" Command="{Binding StopCommand}" Style="{StaticResource AppButton}" Margin="0,0,8,0" />
                                                <Button Content="{Binding CleanButtonText}" Command="{Binding CleanCommand}" Tag="primary"
                                                        Style="{StaticResource AppButton}" Padding="18,8" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </TabItem>

                        <!-- Old leftovers: folders nothing installed owns. Guesses, so nothing is ticked for you. -->
                        <TabItem Header="Old leftovers">
                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="8" DataContext="{Binding OrphanScan}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Margin="20,16,20,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Folders left behind by programs that are gone" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Content="Stop" Command="{Binding StopCommand}" Style="{StaticResource AppButton}" Margin="0,0,8,0" />
                                            <Button Content="Find leftovers" Command="{Binding FindCommand}" Style="{StaticResource AppButton}" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Grid.Row="1">
                                        <DataGrid Style="{StaticResource ProgramGrid}" ItemsSource="{Binding Rows}" AutomationProperties.Name="Old leftover folders">
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Width="48" CanUserSort="False" CanUserResize="False" IsReadOnly="True">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                                                                      AutomationProperties.Name="Tick to move to the Recycle Bin" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Header="Folder" Width="*" MinWidth="200" Binding="{Binding Name, Mode=OneWay}" ElementStyle="{StaticResource CellTextName}" />
                                                <DataGridTextColumn Header="Where" Width="160" Binding="{Binding Location, Mode=OneWay}" ElementStyle="{StaticResource CellTextMuted}" />
                                                <DataGridTextColumn Header="Size" Width="100" HeaderStyle="{StaticResource GridColumnHeaderRight}"
                                                                    Binding="{Binding SizeText, Mode=OneWay}" ElementStyle="{StaticResource CellTextNumber}" />
                                                <DataGridTextColumn Header="Last changed" Width="130" Binding="{Binding LastChangedText, Mode=OneWay}" ElementStyle="{StaticResource CellTextMuted}" />
                                                <DataGridTemplateColumn Width="90" CanUserSort="False" IsReadOnly="True">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button Content="Look" Style="{StaticResource AppButton}" Padding="12,4"
                                                                    Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                    CommandParameter="{Binding}" ToolTip="{Binding Path}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <Border Background="{DynamicResource SurfaceBrush}" Margin="0,38,0,0" VerticalAlignment="Top" Height="320"
                                                Visibility="{Binding ShowSkeleton, Converter={StaticResource BoolToVis}}" helpers:Motion.FadeIn="True">
                                            <views:SkeletonRows RowCount="7" ShowTick="True" />
                                        </Border>
                                        <TextBlock Text="Nothing to clean up here." FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding IsEmptyAfterScan, Converter={StaticResource BoolToVis}}" />
                                    </Grid>

                                    <Border Grid.Row="2" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="20,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SelectedText}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding ResultText}" Foreground="{DynamicResource OkBrush}" FontWeight="SemiBold" FontSize="12"
                                                           TextWrapping="Wrap" Margin="0,2,0,0"
                                                           Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="{Binding MoveButtonText}" Command="{Binding MoveCommand}" Tag="primary"
                                                    Style="{StaticResource AppButton}" Padding="18,8" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </TabItem>
                    </TabControl>
                </TabItem>

                <!-- ================= Undo center ================= -->
                <TabItem Header="Undo center">
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" DataContext="{Binding Undo}" helpers:Motion.RiseIn="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DataGrid Style="{StaticResource ProgramGrid}" ItemsSource="{Binding Items}" AutomationProperties.Name="Backups">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="When" Width="150" Binding="{Binding DateText, Mode=OneWay}" ElementStyle="{StaticResource CellTextMuted}" />
                                    <DataGridTextColumn Header="Type" Width="150" Binding="{Binding TypeText, Mode=OneWay}" ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="Program" Width="220" Binding="{Binding Program, Mode=OneWay}" ElementStyle="{StaticResource CellTextName}" />
                                    <DataGridTextColumn Header="What" Width="*" MinWidth="240" Binding="{Binding Description, Mode=OneWay}" ElementStyle="{StaticResource CellTextMuted}" />
                                    <DataGridTextColumn Header="State" Width="90" Binding="{Binding StateText, Mode=OneWay}" ElementStyle="{StaticResource CellText}" />
                                    <DataGridTemplateColumn Width="110" CanUserSort="False" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Restore" Style="{StaticResource AppButton}" Padding="12,4"
                                                        Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="Nothing to undo yet. Registry backups, recycled items, restore points and startup changes made by this app are listed here."
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap" MaxWidth="460" TextAlignment="Center"
                                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
                            <Grid Grid.Row="1" Margin="16,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Restoring a registry backup imports its .reg file. A restore point opens Windows System Restore."
                                           Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource AppButton}" Padding="12,5" />
                            </Grid>
                        </Grid>
                    </Border>
                </TabItem>
            </TabControl>

            <!-- Status bar -->
            <Border Grid.Row="2" Padding="24,9"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextMutedBrush}"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}" />
                    <TextBlock Grid.Column="1" Text="{Binding ElevationText}" Margin="16,0,0,0"
                               Foreground="{DynamicResource TextMutedBrush}" />
                </Grid>
            </Border>
        </Grid>

        <!-- A long action is running: the scrim blocks clicks on everything underneath -->
        <Border Background="{DynamicResource ScrimBrush}" helpers:Motion.FadeIn="True"
                Visibility="{Binding IsUninstalling, Converter={StaticResource BoolToVis}}">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28,24" MinWidth="420" MaxWidth="640"
                    helpers:Motion.RiseIn="True"
                    CornerRadius="10" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{Binding BusyText}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Margin="0,6,0,14" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}"
                               Text="{Binding BusyDetail}" />

                    <!-- Batch progress: one line per program -->
                    <ItemsControl ItemsSource="{Binding BatchItems}" Margin="0,0,0,14" MaxHeight="220"
                                  Visibility="{Binding ShowBatchItems, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Message}" />
                                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" HorizontalAlignment="Right"
                                               Foreground="{DynamicResource TextMutedBrush}" FontWeight="SemiBold" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ProgressBar IsIndeterminate="True" Height="4" BorderThickness="0"
                                 Foreground="{DynamicResource AccentBrush}"
                                 Background="{DynamicResource SurfaceAltBrush}" />
                    <Button Content="Stop waiting" Command="{Binding StopWaitingCommand}"
                            Style="{StaticResource AppButton}" HorizontalAlignment="Right" Margin="0,18,0,0"
                            Visibility="{Binding CanStopWaiting, Converter={StaticResource BoolToVis}}"
                            ToolTip="Stops waiting here. The uninstaller itself keeps running." />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
    </Grid>
</Window>
