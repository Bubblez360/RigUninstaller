<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark palette. Same keys as Light.xaml. -->
    <SolidColorBrush x:Key="WindowBgBrush" Color="#14171C" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1C2027" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#262C36" />
    <SolidColorBrush x:Key="BorderBrush" Color="#343B47" />
    <SolidColorBrush x:Key="TextBrush" Color="#E8EBF0" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#98A2B3" />
    <SolidColorBrush x:Key="AccentBrush" Color="#6B9BFF" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#0D1424" />
    <SolidColorBrush x:Key="HoverBrush" Color="#2F3743" />
    <SolidColorBrush x:Key="PressedBrush" Color="#3A4452" />
    <SolidColorBrush x:Key="DividerBrush" Color="#2A303B" />
    <SolidColorBrush x:Key="RowHoverBrush" Color="#222833" />
    <SolidColorBrush x:Key="SelectedRowBrush" Color="#28385A" />
    <SolidColorBrush x:Key="BloatRowBrush" Color="#352D1C" />
    <SolidColorBrush x:Key="ScrimBrush" Color="#D914171C" />
    <SolidColorBrush x:Key="OkBrush" Color="#4CC38A" />
    <SolidColorBrush x:Key="WarnBrush" Color="#E5A94B" />
    <SolidColorBrush x:Key="DangerBrush" Color="#F58A80" />
    <!-- Outline of inputs: at least 3:1 against the surface, so the field can be found -->
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#69758A" />
</ResourceDictionary>
